<?xml version="1.0" ?>
<mujoco model="DeltaNuRobot">



  <compiler angle="radian" eulerseq="xyz"/>
  <option timestep="0.001" gravity="0 0 -9.81" iterations="50"/>
  <asset>
    <mesh name="Base_mesh" file="robot_meshes/Base.stl"/>
    <mesh name="PCB_mesh" file="robot_meshes/PCB.stl" inertia="convex"/>
    <mesh name="PAA5100" file="robot_meshes/PAA5100.stl"/>
    <mesh name="Motor_mesh" file="robot_meshes/SimpleMotorEncoder.stl" inertia="convex"/>
    <mesh name="Bracket_mesh" file="robot_meshes/GearmotorBracket.stl" inertia="convex"/>
    
    <material name="base_mat" rgba="0 0 0 1"/>
    <material name="pcb_mat" rgba="0.2 0.7 0.2 1"/>
    <material name="motor_mat" rgba="0.2 0.2 0.2 1"/>
    <material name="bracket_mat" rgba="0.95 0.95 0.95 1"/>

    <texture name="checker" type="2d" builtin="checker" rgb1=".1 .2 .3" rgb2=".2 .3 .4" width="300" height="300"/>
    <material name="grid" texture="checker" texrepeat="8 8" reflectance=".2"/>

    <model name="wheel" file="wheel.xml"/>
  </asset>
  
  <worldbody>        
    <light directional="true" diffuse=".4 .4 .4" specular="0.1 0.1 0.1" pos="0 0 5.0" dir="0 0 -1" castshadow="false"/>
    <light directional="true" diffuse=".6 .6 .6" specular="0.2 0.2 0.2" pos="0 0 4" dir="0 0 -1"/>

    <body name="Base" pos="0 0 0.05" euler="0 0 0">
      <freejoint/>
      <!-- Base body -->
      <geom name="Base" pos="0 0 0" euler="0 0 0" type="mesh" mesh="Base_mesh" group="0"/>
      <inertial mass="0.037" pos="0 0 -0.01" euler="0 0 0" diaginertia="1e-5
      1e-5 1e-5"/>
      <!-- PAA5100 -->
      <body name="PAA5100" pos="-0.0098 -0.00543 0" euler="3.14159 0 0">
        <geom name="PAA5100" pos="0 0 0" euler="0 0 0" type="mesh" mesh="PAA5100"
        material="pcb_mat" group="1" mass="0.002"/>
        <site name="PAA5100_site" pos="0.0098 -0.00543 0.00338" euler="0 0 0" type="cylinder"
        size="0.002 0.0011 " rgba="0 0 0 1"/>
      </body>

      <!-- PCB and Sensor Sites -->
      <body name="PCB" pos="0 0 0.018" euler="0 0 0">
        <geom name="PCB" pos="0 0 0" euler="0 0 0" type="mesh" mesh="PCB_mesh"
        material="pcb_mat" group="1" mass="0.01456956" />
        <site name="IMU_site" pos="0.005480 -0.001085 0.00218" type="box"
        size="0.003 0.003 0.00075" rgba="0 0 0 1"/>
        <site name="Mag_site" pos="-0.00185695509 -0.00364054491 0.002675"
        type="box" size="0.002 0.002 0.001" rgba="0 0 0 1"/>
      </body>

      <!-- Motors and Brackets -->
      <replicate count="3" pos="0 0 0" euler="0 0 2.0943951023931953">
        <body name="Motor" pos="0 0.05354 0" euler="3.141592 0 -1.5707963267948966">
        <geom name="motor" pos="0 0 0" euler=" 0 0 0" type="mesh" mesh="Motor_mesh"
        material="motor_mat" group="1" mass="0.011"/>
        <geom name="bracket" pos="-0 0 0" euler="0 0 0" type="mesh" mesh="Bracket_mesh"
        material="bracket_mat" group="1" mass="0.005"/>
          <body name="wheel_body" pos="0.005 0 0.005" euler="0 0 1.5707963267948966">
            <attach model="wheel" body="Hub" prefix="wheel"/>
          </body>
        </body>
      </replicate>
    </body>

    
    <geom name="floor" type="plane" pos="0 0 0" euler="0 0 0" size="4 4 0.001" condim="3" conaffinity="15" material="grid"/>
  
  </worldbody>

  <sensor>
    <accelerometer name="mjcf_imu_accel" site="IMU_site" />
    <gyro name="mjcf_imu_gyro" site="IMU_site" />
    <framequat name="mjcf_imu_quat" objtype="site" objname="IMU_site" noise="0.0"/>
    <magnetometer name="mjcf_mag" site="Mag_site"/>
    <framepos name="mjcf_paa5100_pos" objtype="site" objname="PAA5100_site"/>
  </sensor>


</mujoco>
